# Atlas is the primary backend. Paste your own SRV connection string below.
# The password stays in this local file; never commit it (.env is gitignored).
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=memory_demo
PORT=8137

# Optional offline fallback (local Atlas container, needs Docker):
# MONGODB_URI=mongodb://127.0.0.1:27779/?directConnection=true
